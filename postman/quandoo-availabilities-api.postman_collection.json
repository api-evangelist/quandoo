                          "body": "{\n  \"days\": [\n    \"<date>\",\n    \"<date>\"\n  ],\n  \"links\": [\n    {\n      \"href\": \"<string>\",\n      \"method\": \"<string>\",\n      \"rel\": \"CREATE_RESERVATION\"\n    },\n    {\n      \"href\": \"<string>\",\n      \"method\": \"<string>\",\n      \"rel\": \"RESERVATION_CHECKOUT_PAGE\"\n    }\n  ]\n}",
