{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Tracking",
  "description": "Tracking schema from Quandoo Public Partner API",
  "$id": "https://raw.githubusercontent.com/api-evangelist/quandoo/refs/heads/main/json-schema/quandoo-public-partner-api-tracking-schema.json",
  "type": "object",
  "required": [
    "agent"
  ],
  "properties": {
    "agent": {
      "type": "object",
      "required": [
        "id"
      ],
      "properties": {
        "id": {
          "type": "integer",
          "format": "int32",
          "description": "An agent id. Required."
        }
      }
    },
    "cookie": {
      "type": "object",
      "properties": {
        "tracking": {
          "type": "string",
          "description": "A tracking string to be stored with the reservation. Optional."
        },
        "referenceId": {
          "type": "string",
          "description": "A reference id to be stored with the reservation. Optional."
        }
      }
    }
  }
}